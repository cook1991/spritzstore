<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The one sibling app that needs this on purpose: it only ever talks to
         api.github.com to check for and download updates. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lets SpritzStore hand APKs to PackageInstaller. Still requires the one-time
         "Install unknown apps" grant in Settings, and still shows the system install
         confirmation on every install; this permission alone doesn't skip either. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Periodic background update checks. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Without this, Android 11+ package-visibility filtering hides every OTHER app's
         install status from getPackageInfo(); SpritzStore would see itself fine (self-
         visibility is always granted) but every tracked sibling app would look
         permanently "not installed" even when it's genuinely there. A static <queries>
         list naming each sibling's applicationId was the alternative, but the tracked-
         repo list is user-editable at runtime (Settings -> add repo), so a build-time
         list would silently drift out of sync. QUERY_ALL_PACKAGES is a normal (non-
         dangerous, no prompt) permission; its Play Store review restriction doesn't
         apply here since this app is never distributed through Play Store. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".SpritzStoreApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpritzStore">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SpritzStore">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".install.InstallResultReceiver"
            android:exported="false" />

    </application>

</manifest>
